FROM node:24.21.0-bookworm-slim AS build
WORKDIR /source
RUN corepack enable && corepack prepare pnpm@10.30.2 --activate
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm build:devpass && pnpm --filter @proofrun/contracts build && pnpm build:execution
# 发布构建运行固定本地协议基准，任何失败直接阻止生成镜像。
RUN pnpm --filter @proofrun/agent build && node scripts/benchmarks/agent-loop.mjs
RUN pnpm --filter @proofrun/api build && pnpm --filter @proofrun/api deploy --prod --legacy /runtime

# 真实基准由 CI 校验；镜像独立记录提交和源码指纹，不依赖报告。
FROM build AS versioned
ARG RAILWAY_GIT_COMMIT_SHA
RUN node scripts/benchmarks/write-build-info.mjs --output /runtime/dist/build-info.json

FROM node:24.21.0-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
COPY --from=versioned /runtime ./
# 配置在启动时读取；模型密钥和业务环境不进入镜像层。
COPY deploy/railway/api-entry.mjs ./railway-entry.mjs
ENV PROOFRUN_API_HOST=:: PROOFRUN_ARTIFACT_DIRECTORY=/data/artifacts
EXPOSE 4100
CMD ["node", "railway-entry.mjs"]
