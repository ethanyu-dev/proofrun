{
    # TLS 由 Railway 边缘处理；容器只监听分配的 HTTP 端口。
    admin off
    auto_https off
}
:{$PORT:8080} {
    # 退役入口不得落入 Console 的 SPA 回退。
    @retired path /v3/* /mcp/*
    handle @retired {
        respond 404
    }
    @control path /v1/* /v2/* /health/* /docs /docs/* /openapi.json
    handle @control {
        # 保留 Railway 边缘重写的 X-Real-IP 与 Cloudflare 来源头，API 的 railway 模式负责解析。
        # 不用 Caddy 自动重建的 X-Forwarded-For 作为客户端身份，避免丢失跨层来源。
        reverse_proxy {$PROOFRUN_API_UPSTREAM}
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
    header X-Content-Type-Options nosniff
}
