FROM node:24.21.0-bookworm-slim AS build
WORKDIR /source
RUN corepack enable && corepack prepare pnpm@10.30.2 --activate
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @proofrun/contracts build
RUN pnpm build:execution && pnpm --filter @proofrun/agent build && node scripts/benchmarks/agent-loop.mjs
RUN pnpm --filter @proofrun/console build

# 真实基准由 CI 校验；镜像独立记录提交和源码指纹，不依赖报告。
FROM build AS versioned
ARG RAILWAY_GIT_COMMIT_SHA
RUN node scripts/benchmarks/write-build-info.mjs --output /source/apps/console/dist/build-info.json

FROM caddy:2-alpine@sha256:6aeddd44c3078b0f9a35206472a11420648a79c184603ef95957d0a20044cb2b
COPY --from=versioned /source/apps/console/dist /srv
COPY deploy/railway/Caddyfile /etc/caddy/Caddyfile
ENV PORT=8080
EXPOSE 8080
