{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GetAccountInput",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "调用方范围内的业务幂等键。"
    },
    "platform": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "目标平台的稳定标识。"
    },
    "origin": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "description": "凭据适用的精确源，不含业务路径。"
    },
    "role_description": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "description": "账号登记的能力标签，不代表页面实际验证通过。"
      }
    },
    "accepted_material_types": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["http_bearer", "browser_cookies", "browser_storage"]
      }
    },
    "duration_seconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 7200
    },
    "account_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "pool_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": ["request_id", "platform", "origin", "accepted_material_types"],
  "description": "请求一次固定期限的账号使用额度。"
}
