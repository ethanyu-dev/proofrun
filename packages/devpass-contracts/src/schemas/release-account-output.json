{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReleaseAccountOutput",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1",
          "type": "string"
        },
        "status": {
          "const": "released",
          "type": "string"
        },
        "lease_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "released_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["schema_version", "status", "lease_id", "released_at"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1",
          "type": "string"
        },
        "status": {
          "const": "release_pending",
          "type": "string"
        },
        "lease_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "released_at": {
          "type": "null"
        }
      },
      "required": ["schema_version", "status", "lease_id", "released_at"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1",
          "type": "string"
        },
        "status": {
          "const": "error",
          "type": "string"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "FORBIDDEN",
                "IDEMPOTENCY_CONFLICT",
                "DURATION_NOT_ALLOWED",
                "RECIPIENT_KEY_UNAVAILABLE",
                "LEASE_NOT_FOUND",
                "LEASE_EXPIRED",
                "LEASE_CLOSED",
                "MATERIAL_REVOKED",
                "RELEASE_CONFLICT",
                "RATE_LIMITED",
                "TEMPORARY_UNAVAILABLE",
                "INVALID_ARGUMENT"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "retryable": {
              "type": "boolean"
            },
            "retry_after_seconds": {
              "type": ["integer", "null"],
              "minimum": 0
            }
          },
          "required": ["code", "message", "retryable", "retry_after_seconds"]
        }
      },
      "required": ["schema_version", "status", "error"]
    }
  ]
}
