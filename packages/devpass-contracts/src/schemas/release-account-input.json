{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReleaseAccountInput",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "lease_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "本次使用的租约 ID，不是账号 ID。"
    },
    "usage_stopped": {
      "type": "boolean",
      "description": "由可信执行环境确认资源停止，不能以任务完成代替。"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "completed",
        "cancelled",
        "credential_invalid",
        "identity_mismatch",
        "account_state_changed",
        "execution_error"
      ]
    },
    "note": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "required": ["lease_id", "usage_stopped", "outcome"]
}
