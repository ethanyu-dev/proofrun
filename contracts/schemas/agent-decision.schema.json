{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentDecision",
  "description": "模型提出的单步浏览器意图或逐项验收结果；平台补充身份并检查证据。",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "browser.observe"
        },
        "screenshot": {
          "description": "是否同时采集 PNG 截图；截图与 DOM 来自不同时间点。",
          "type": "boolean"
        },
        "progress": {
          "$ref": "#/definitions/progress"
        }
      },
      "required": ["type"],
      "description": "采集页面事实，返回新的 observationId 和该次观察范围内的元素目标。"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "network.request_detail"
        },
        "observationId": {
          "type": "string",
          "minLength": 1,
          "description": "当前 page.network.observationId；分页与详情只读取该次快照。"
        },
        "progress": {
          "$ref": "#/definitions/progress"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "从网络摘要列表获取的请求 ID。"
        }
      },
      "required": ["type", "observationId", "requestId"],
      "description": "只读查看一个请求已采集的脱敏元数据与证据引用；不会重放请求，未采集正文不可补造。"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "network.requests"
        },
        "observationId": {
          "type": "string",
          "minLength": 1,
          "description": "当前 page.network.observationId；分页与详情只读取该次快照。"
        },
        "progress": {
          "$ref": "#/definitions/progress"
        },
        "urlContains": {
          "type": "string",
          "maxLength": 500,
          "description": "按已脱敏 URL 子串筛选，不是正则表达式。"
        },
        "status": {
          "type": ["integer", "null"],
          "minimum": 100,
          "maximum": 599,
          "description": "按状态码筛选；null 表示未收到响应。"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "description": "筛选结果偏移；省略为 0，每页最多 20 条。"
        }
      },
      "required": ["type", "observationId"],
      "description": "只读查询已采集网络请求的摘要列表；不会导航、重新取证或发出 HTTP 请求。"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "browser.act"
        },
        "action": {
          "description": "受限的浏览器动作；任一动作都可能产生业务副作用。",
          "enum": [
            "navigate",
            "click",
            "fill",
            "press",
            "scroll",
            "hover",
            "check",
            "uncheck",
            "select",
            "type",
            "back",
            "forward",
            "reload",
            "frame",
            "tab.new",
            "tab.switch",
            "tab.close",
            "resize",
            "visual.click",
            "online",
            "pwa.cleanup",
            "network.probe"
          ]
        },
        "target": {
          "description": "导航为 HTTP(S) URL；元素动作为当前观察 target；frame 为 iframe target 或 main；tab.switch/close 为已观察 tabId。",
          "type": "string"
        },
        "value": {
          "description": "填写/输入/选择的值、按键、滚动方向或 resize 的 WIDTHxHEIGHT。",
          "type": "string"
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 16384,
          "description": "visual.click 使用当前截图的视口 CSS 坐标。"
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 16384,
          "description": "visual.click 使用当前截图的视口 CSS 坐标。"
        },
        "progress": {
          "$ref": "#/definitions/progress"
        },
        "revisitReason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        }
      },
      "required": ["type", "action"],
      "description": "执行一次浏览器动作。生产环境默认关闭，直到引擎丢响应后的写入行为得到验证。"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "browser.wait"
        },
        "selector": {
          "description": "要匹配的 CSS 选择器；逐层搜索 open Shadow DOM 及同源 iframe。",
          "type": "string"
        },
        "text": {
          "description": "目标元素文本中必须包含的字符串。",
          "type": "string"
        },
        "progress": {
          "$ref": "#/definitions/progress"
        }
      },
      "required": ["type", "selector", "text"],
      "description": "等待一个明确的选择器及文本条件成立。"
    },
    {
      "title": "FinishVerification",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "verification.finish"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "description": "基于已取得证据解释本次验收结论。"
        },
        "evidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "结构化步骤完成的执行证据，setup 无验收项时也必须提供。"
        },
        "progress": {
          "$ref": "#/definitions/progress"
        }
      },
      "required": ["type", "summary"]
    },
    {
      "title": "BlockVerification",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "verification.block"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "description": "具体缺失的前提或定义，交由上层修正；不改写标准。"
        },
        "reasonCode": {
          "enum": ["LOGIN_REQUIRED", "IDENTITY_UNCONFIRMED", "OTHER"],
          "description": "登录缺失或失效用 LOGIN_REQUIRED；账号角色、绑定或资格待确认用 IDENTITY_UNCONFIRMED；其余用 OTHER。平台在授权范围内先尝试一次人工交接，兼容旧回复省略此字段。"
        },
        "progress": {
          "$ref": "#/definitions/progress"
        }
      },
      "required": ["type", "summary"]
    },
    {
      "title": "RequestHumanAssistance",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "verification.intervene"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "description": "本次人工需要处理的事项，不替代原验收标准。"
        },
        "reasonCode": {
          "enum": ["LOGIN_REQUIRED", "IDENTITY_UNCONFIRMED", "OTHER"],
          "description": "登录缺失单独交接，不占用其他未解决条件的交接机会。"
        },
        "progress": {
          "$ref": "#/definitions/progress"
        }
      },
      "required": ["type", "reason"]
    },
    {
      "title": "RecordVerification",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "verification.record"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "description": "基于已取得证据解释本次验收结论。"
        },
        "progress": {
          "$ref": "#/definitions/progress"
        }
      },
      "required": ["type", "summary", "progress"],
      "description": "立即保存当前步骤已取得证据的部分验收结论，不结束步骤；已保存结论不会被后续故障覆盖。"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "description": "仅在后续清理阶段删除任务站点明确指定名称的 Cookie，并核实已删除；不会返回 Cookie 值。",
      "properties": {
        "type": {
          "const": "browser.cookies.clear"
        },
        "names": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9!#$%&'*+.^_`|~-]+$"
          }
        },
        "progress": {
          "$ref": "#/definitions/progress"
        }
      },
      "required": ["type", "names"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "verification.environment"
        },
        "mode": {
          "enum": ["guest", "configured"]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "progress": {
          "$ref": "#/definitions/progress"
        }
      },
      "required": ["type", "mode", "summary"],
      "description": "仅共享环境准备阶段使用。依据原始 setup 与 policy 声明是否必须使用未登录访客；这是意图分类，不是登录事实证明，平台单独核实准备来源。"
    }
  ],
  "definitions": {
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requirements": {
          "type": "array",
          "maxItems": 33,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": ["complete", "incomplete", "blocked"]
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "evidenceRefs": {
                "type": "array",
                "maxItems": 24,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": ["id", "status", "summary", "evidenceRefs"]
          }
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["criterionId", "verdict", "summary", "evidenceRefs"],
            "properties": {
              "criterionId": {
                "type": "string",
                "minLength": 1
              },
              "verdict": {
                "enum": ["PASSED", "FAILED", "INCONCLUSIVE", "SKIPPED"]
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "evidenceRefs": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "verdict": {
                      "enum": ["PASSED", "FAILED"]
                    }
                  },
                  "required": ["verdict"]
                },
                "then": {
                  "properties": {
                    "evidenceRefs": {
                      "type": "array",
                      "minItems": 1
                    }
                  }
                }
              }
            ]
          },
          "minItems": 0
        },
        "readings": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "itemId": {
                "type": "string"
              },
              "quote": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              }
            },
            "required": ["itemId", "quote"]
          }
        }
      }
    }
  }
}
