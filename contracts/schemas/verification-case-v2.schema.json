{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://proofrun.invalid/contracts/0.1/verification-case-v2.schema.json",
  "title": "VerificationCaseV2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "caseId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$",
      "description": "本次任务的幂等身份；重跑必须使用新的身份。"
    },
    "platform": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 2000,
      "description": "业务平台标签，不用于自动选择登录账号。"
    },
    "entry": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "description": "任务所属站点的 HTTP(S) 入口。"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 2000,
      "description": "任务背景，省略时由平台生成不含额外验收标准的概述。"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "case-step.schema.json"
      },
      "contains": {
        "type": "object",
        "properties": {
          "type": {
            "const": "verification"
          }
        },
        "required": ["type"]
      },
      "description": "上游定义的操作与验收步骤；服务端补齐身份后稳定排序。"
    },
    "cleanup": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "stepId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "exec_order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000,
            "description": "升序执行；同值按原数组顺序串行。"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "maxLength": 2000
          },
          "policy": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S",
              "maxLength": 2000
            }
          },
          "expected": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S",
              "maxLength": 2000
            }
          }
        },
        "required": ["url", "exec_order", "description"]
      },
      "description": "在同一任务和浏览器会话末尾执行的业务清理操作，不是浏览器资源回收。"
    }
  },
  "required": ["caseId", "platform", "entry", "steps", "cleanup"]
}
