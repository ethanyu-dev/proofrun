{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://proofrun.invalid/contracts/0.1/request-result-v2.schema.json",
  "title": "RequestResultV2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$",
      "description": "逻辑提交的稳定身份；重试沿用，重跑使用新身份。"
    },
    "title": {
      "type": "string",
      "description": "展示标题首次接收后冻结，不生成或改写验证目标。"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "原记录创建时间；复用时不会改成本次请求时间。"
    },
    "sourceRequestId": {
      "type": ["string", "null"],
      "description": "整请求重跑的来源；普通提交为 null。"
    },
    "aggregationVersion": {
      "const": 1,
      "description": "判定算法版本，页面和导出必须一致。"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "当前一致性读取快照时间，不代表执行结束。"
    },
    "caseCount": {
      "type": "integer",
      "minimum": 0,
      "description": "当前范围内的 case 数。"
    },
    "finishedCaseCount": {
      "type": "integer",
      "minimum": 0,
      "description": "全部要求组已结束的 case 数，不代表验收通过。"
    },
    "executionStatus": {
      "enum": ["QUEUED", "IN_PROGRESS", "FINISHED"],
      "description": "请求执行进度，不代表业务通过。"
    },
    "executionCounts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "description": "该统计范围的总数，不能混同 case 数与执行次数。"
        },
        "queued": {
          "type": "integer",
          "minimum": 0,
          "description": "仍在队列中的执行组数。"
        },
        "running": {
          "type": "integer",
          "minimum": 0,
          "description": "正在运行的执行组数，包括等待人工处理。"
        },
        "completed": {
          "type": "integer",
          "minimum": 0,
          "description": "执行完成组数，不等同于业务通过。"
        },
        "cancelled": {
          "type": "integer",
          "minimum": 0,
          "description": "被取消的执行组数，不直接视为产品失败。"
        },
        "timedOut": {
          "type": "integer",
          "minimum": 0,
          "description": "执行超时组数，不直接视为产品失败。"
        },
        "error": {
          "type": "integer",
          "minimum": 0,
          "description": "异常终止组数，包含执行阻塞。"
        }
      },
      "required": [
        "total",
        "queued",
        "running",
        "completed",
        "cancelled",
        "timedOut",
        "error"
      ],
      "description": "冻结执行组的生命周期计数；各分类互斥。"
    },
    "reportPhase": {
      "enum": ["PENDING", "PARTIAL", "FINAL"],
      "description": "全部要求组结束后为 FINAL，包括缺少报告的情况。"
    },
    "reportStatus": {
      "enum": ["PASSED", "FAILED", "INCONCLUSIVE", null],
      "description": "所有要求组的业务结论；尚未全部结束时为 null。"
    },
    "reportCoverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected": {
          "type": "integer",
          "minimum": 0,
          "description": "冻结要求或原始验收标准，不由汇总补造。"
        },
        "available": {
          "type": "integer",
          "minimum": 0,
          "description": "已经交付报告的执行组数。"
        },
        "missing": {
          "type": "integer",
          "minimum": 0,
          "description": "尚无报告的执行组数，终态仍可缺失。"
        }
      },
      "required": ["expected", "available", "missing"],
      "description": "报告齐全程度，不根据执行终态推测报告存在。"
    },
    "observedFailureCount": {
      "type": "integer",
      "minimum": 0,
      "description": "已交付报告确认失败的唯一项数，部分结果期间也展示。"
    },
    "uniqueCriteriaCounts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "description": "该统计范围的总数，不能混同 case 数与执行次数。"
        },
        "passed": {
          "type": "integer",
          "minimum": 0,
          "description": "满足该范围全部要求的通过数量。"
        },
        "failed": {
          "type": "integer",
          "minimum": 0,
          "description": "已交付结论中确认失败的数量。"
        },
        "inconclusive": {
          "type": "integer",
          "minimum": 0,
          "description": "仍无法形成确定结论，包括通过与缺失并存。"
        },
        "skipped": {
          "type": "integer",
          "minimum": 0,
          "description": "未验收或所有要求组均缺失该项的数量。"
        },
        "pending": {
          "type": "integer",
          "minimum": 0,
          "description": "尚有要求组未结束，且该项没有明确失败。"
        }
      },
      "required": [
        "total",
        "passed",
        "failed",
        "inconclusive",
        "skipped",
        "pending"
      ],
      "description": "按 caseId 和 criterionId 去重。"
    },
    "byExecutionMode": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "executionMode": {
            "enum": ["llm"],
            "description": "冻结的 LLM 执行模式。"
          },
          "caseCount": {
            "type": "integer",
            "minimum": 0,
            "description": "当前范围内的 case 数。"
          },
          "missingReportCount": {
            "type": "integer",
            "minimum": 0,
            "description": "当前模式要求组中没有报告的数量。"
          },
          "criteriaCounts": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "total": {
                "type": "integer",
                "minimum": 0,
                "description": "该统计范围的总数，不能混同 case 数与执行次数。"
              },
              "passed": {
                "type": "integer",
                "minimum": 0,
                "description": "满足该范围全部要求的通过数量。"
              },
              "failed": {
                "type": "integer",
                "minimum": 0,
                "description": "已交付结论中确认失败的数量。"
              },
              "inconclusive": {
                "type": "integer",
                "minimum": 0,
                "description": "仍无法形成确定结论，包括通过与缺失并存。"
              },
              "skipped": {
                "type": "integer",
                "minimum": 0,
                "description": "未验收或所有要求组均缺失该项的数量。"
              }
            },
            "required": [
              "total",
              "passed",
              "failed",
              "inconclusive",
              "skipped"
            ],
            "description": "当前模式已交付报告的原单组统计。"
          }
        },
        "required": [
          "executionMode",
          "caseCount",
          "missingReportCount",
          "criteriaCounts"
        ]
      },
      "description": "按模式汇总；未配置该模式的 case 不计缺失。",
      "maxItems": 1
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "caseId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$",
            "description": "全局 case 幂等身份，不改为请求内局部身份。"
          },
          "title": {
            "type": "string",
            "description": "展示标题首次接收后冻结，不生成或改写验证目标。"
          },
          "executionOrigin": {
            "enum": ["created", "reused"],
            "description": "接收时创建或复用的冻结事实，不因重提改变。"
          },
          "sourceCaseId": {
            "type": ["string", "null"],
            "description": "整请求重跑对应的原 case；普通提交为 null。"
          },
          "reportStatus": {
            "enum": ["PASSED", "FAILED", "INCONCLUSIVE", null],
            "description": "所有要求组的业务结论；尚未全部结束时为 null。"
          },
          "finished": {
            "type": "boolean",
            "description": "全部要求组进入终态，不代表业务通过。"
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "criterionId": {
                  "type": "string",
                  "description": "原 expected 的稳定身份；跨 case 用复合身份关联。"
                },
                "stepId": {
                  "type": "string",
                  "description": "排序不改变的冻结步骤身份。"
                },
                "description": {
                  "type": "string",
                  "description": "调用方的说明，不添加额外验证要求。"
                },
                "expectedResult": {
                  "type": "string",
                  "description": "调用方明确声明的单条验收标准。"
                },
                "status": {
                  "enum": [
                    "PASSED",
                    "FAILED",
                    "INCONCLUSIVE",
                    "SKIPPED",
                    "PENDING"
                  ],
                  "description": "当前层级的执行或验收状态，不能跨层级解释。"
                },
                "arms": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "taskId": {
                        "type": "string",
                        "description": "原执行任务身份，用于报告和证据追溯。"
                      },
                      "executionMode": {
                        "enum": ["llm"],
                        "description": "冻结的 LLM 执行模式。"
                      },
                      "verdict": {
                        "enum": [
                          "PASSED",
                          "FAILED",
                          "INCONCLUSIVE",
                          "SKIPPED",
                          null
                        ],
                        "description": "该执行组该项原始判断；无报告时为 null。"
                      },
                      "summary": {
                        "type": "string",
                        "description": "报告已交付的观察和依据，汇总不会再次生成。"
                      },
                      "evidenceRefs": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "description": "只引用当前 case 和执行组登记的证据。"
                      }
                    },
                    "required": [
                      "taskId",
                      "executionMode",
                      "verdict",
                      "summary",
                      "evidenceRefs"
                    ]
                  },
                  "description": "首次接收冻结的实际执行组，不随平台配置变化。",
                  "maxItems": 1
                }
              },
              "required": [
                "criterionId",
                "stepId",
                "description",
                "expectedResult",
                "status",
                "arms"
              ]
            },
            "description": "按业务标准身份对齐的各组结论，清理不计入。"
          },
          "arms": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "taskId": {
                  "type": "string",
                  "description": "原执行任务身份，用于报告和证据追溯。"
                },
                "executionMode": {
                  "enum": ["llm"],
                  "description": "冻结的 LLM 执行模式。"
                },
                "createdAt": {
                  "type": "string",
                  "format": "date-time",
                  "description": "原记录创建时间；复用时不会改成本次请求时间。"
                },
                "archivedAt": {
                  "type": ["string", "null"],
                  "description": "证据清理时间；原结论保留，下载应禁用。"
                },
                "result": {
                  "$ref": "case-result-v2.schema.json",
                  "description": "原单组公开结果，不能代表另一组。"
                }
              },
              "required": [
                "taskId",
                "executionMode",
                "createdAt",
                "archivedAt",
                "result"
              ]
            },
            "description": "首次接收冻结的实际执行组，不随平台配置变化。",
            "maxItems": 1
          },
          "steps": {
            "type": "array",
            "description": "冻结的步骤定义，准备、业务验证和后续清理分别展示。",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "stepId",
                "type",
                "description",
                "expected",
                "cleanup"
              ],
              "properties": {
                "stepId": {
                  "type": "string",
                  "description": "排序不改变的冻结步骤身份。"
                },
                "type": {
                  "enum": ["setup", "verification"],
                  "description": "原步骤类型，保持执行顺序与准备门禁。"
                },
                "description": {
                  "type": "string",
                  "description": "调用方的说明，不添加额外验证要求。"
                },
                "expected": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "冻结要求或原始验收标准，不由汇总补造。"
                },
                "cleanup": {
                  "type": "boolean",
                  "description": "后续清理独立展示，不进入业务统计。"
                }
              }
            }
          }
        },
        "required": [
          "caseId",
          "title",
          "executionOrigin",
          "sourceCaseId",
          "reportStatus",
          "finished",
          "criteria",
          "arms",
          "steps"
        ]
      },
      "description": "首次接收冻结的成员与顺序，不按当前筛选截断。"
    },
    "metrics": {
      "$ref": "request-metrics.schema.json",
      "description": "详情与导出的同一快照统计；旧服务和列表可省略。"
    }
  },
  "required": [
    "requestId",
    "title",
    "createdAt",
    "sourceRequestId",
    "aggregationVersion",
    "generatedAt",
    "caseCount",
    "finishedCaseCount",
    "executionStatus",
    "executionCounts",
    "reportPhase",
    "reportStatus",
    "reportCoverage",
    "observedFailureCount",
    "uniqueCriteriaCounts",
    "byExecutionMode",
    "cases"
  ]
}
