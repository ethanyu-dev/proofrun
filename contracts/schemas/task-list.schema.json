{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://proofrun.invalid/contracts/0.1/task-list.schema.json",
  "title": "TaskList",
  "type": "object",
  "description": "管理员任务列表；按创建时间和身份倒序游标分页。",
  "additionalProperties": false,
  "required": ["tasks", "nextCursor"],
  "properties": {
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "列表摘要只包含展示字段，不返回完整报告和执行凭据。",
        "additionalProperties": false,
        "required": [
          "id",
          "objective",
          "node_pool",
          "target_url",
          "state",
          "created_at",
          "finished_at",
          "execution_disposition",
          "verdict",
          "reportStatus",
          "criteriaCounts",
          "archived_at",
          "evidenceCount"
        ],
        "properties": {
          "parentTaskId": {
            "type": ["string", "null"],
            "description": "清理所属的主任务身份；列表相邻行不代表归属。旧响应可缺失。"
          },
          "id": {
            "type": "string"
          },
          "caseId": {
            "type": ["string", "null"],
            "description": "结构化 case 的原始身份；两组及历史清理指向同一 case，普通任务为 null。"
          },
          "objective": {
            "type": "string"
          },
          "node_pool": {
            "type": "string"
          },
          "target_url": {
            "type": "string"
          },
          "state": {
            "enum": [
              "QUEUED",
              "RUNNING",
              "COMPLETED",
              "CANCELLED",
              "TIMED_OUT",
              "ERROR"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "finished_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "execution_disposition": {
            "enum": ["EXECUTED", "BLOCKED", "ERROR", null]
          },
          "verdict": {
            "enum": ["PASSED", "FAILED", "INCONCLUSIVE", null]
          },
          "reportStatus": {
            "enum": ["PASSED", "FAILED", "INCONCLUSIVE", null],
            "description": "验证报告状态：通过、未通过、无法判定；无报告时为 null。执行状态不等于验收结论，已确认失败优先于未覆盖项。"
          },
          "criteriaCounts": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "total",
                  "passed",
                  "failed",
                  "inconclusive",
                  "skipped"
                ],
                "properties": {
                  "total": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "本次定义的验收项总数。"
                  },
                  "passed": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "通过项数。"
                  },
                  "failed": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "未通过项数。"
                  },
                  "inconclusive": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "已验收但无法判定的项数。"
                  },
                  "skipped": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "未验收或报告缺失的项数。"
                  }
                }
              }
            ],
            "description": "按本次验收定义统计，各分类之和等于 total；无报告时为 null。"
          },
          "archived_at": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "证据清理时间；清理后保留报告结论。"
          },
          "evidenceCount": {
            "type": ["integer", "null"],
            "minimum": 0,
            "description": "报告收录的证据数量；无报告为 null，数量不表示证据仍可下载。"
          }
        },
        "title": "TaskSummary"
      }
    },
    "nextCursor": {
      "type": ["string", "null"]
    }
  }
}
