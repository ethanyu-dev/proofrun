{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "mode": {
      "enum": ["guest", "manual", "identity", "pool", "external"]
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "accountKey": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "nodeId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "stateId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "origins": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "maxItems": 16
          },
          "checks": {
            "type": "array",
            "items": {
              "$ref": "identity-check.schema.json"
            },
            "maxItems": 32
          },
          "loginRef": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "maxConcurrent": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          },
          "libraryVersion": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "identityType": {
            "type": "string",
            "maxLength": 100
          },
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2000
          }
        },
        "required": [
          "id",
          "label",
          "accountKey",
          "origins",
          "checks",
          "maxConcurrent"
        ]
      },
      "maxItems": 256
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "identity-check.schema.json"
      },
      "maxItems": 32
    },
    "preparationMs": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 300000
    },
    "library": {
      "type": "boolean",
      "description": "仅兼容历史本地身份快照，新执行不允许启用。"
    },
    "selection": {
      "enum": ["pending", "selected", "human"]
    },
    "selectionReason": {
      "type": "string",
      "maxLength": 1000
    },
    "external": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selector": {
          "$ref": "external-account-selector.schema.json"
        },
        "origin": {
          "type": "string",
          "format": "uri"
        },
        "durationSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 7200
        }
      },
      "required": ["selector", "origin", "durationSeconds"]
    }
  },
  "required": [
    "version",
    "mode",
    "candidates",
    "requirements",
    "preparationMs"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://proofrun.invalid/contracts/0.1/session-plan.schema.json",
  "title": "SessionPlan",
  "description": "执行会话快照。新任务仅生成 guest/manual/external；旧本地身份字段仅用于读取历史快照，提交与执行入口拒绝使用。",
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "external"
          }
        }
      },
      "then": {
        "required": ["external"],
        "properties": {
          "external": {},
          "candidates": {
            "maxItems": 0,
            "type": "array"
          },
          "requirements": {
            "minItems": 1,
            "type": "array"
          },
          "library": {
            "const": false
          }
        }
      },
      "else": {
        "not": {
          "required": ["external"]
        }
      }
    }
  ]
}
