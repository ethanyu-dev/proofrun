{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://proofrun.invalid/contracts/0.1/mcp-task-call.schema.json",
  "title": "McpTaskCall",
  "description": "两套任务级 MCP 与公共 HTTP 共用的第一阶段输入契约；未知字段及外部控制显式拒绝。",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "browser_get_capabilities"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192,
              "format": "uri",
              "pattern": "^https?://"
            },
            "runId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9_-]{1,160}$"
            }
          },
          "required": []
        }
      },
      "required": ["name", "arguments"],
      "description": "读取浏览器委托任务能力与未检查项；不探测业务网址。"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "browser_task_submit"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "taskKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[A-Za-z0-9_-]{1,80}$"
            },
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192,
              "format": "uri",
              "pattern": "^https?://"
            },
            "objective": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000,
              "pattern": "\\S"
            }
          },
          "required": ["taskKey", "url", "objective"]
        }
      },
      "required": ["name", "arguments"],
      "description": "异步委托内置 Agent 执行浏览器目标；可能产生业务写入。同键重试不重新执行，不支持身份覆盖或直接控制。"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "browser_task_get"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "runId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9_-]{1,160}$"
            },
            "view": {
              "enum": ["summary", "full"]
            },
            "cursor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "required": ["runId"]
        }
      },
      "required": ["name", "arguments"],
      "description": "读取明确运行的浏览器结果；完成不表示验证通过。"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "browser_task_cancel"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "runId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9_-]{1,160}$"
            },
            "operationId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 36,
              "format": "uuid"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "required": ["runId", "operationId"]
        }
      },
      "required": ["name", "arguments"],
      "description": "取消指定浏览器运行并请求关闭；已发生写入不会回滚。"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "browser_evidence_read"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "runId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9_-]{1,160}$"
            },
            "evidenceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]{1,128}$"
            },
            "representation": {
              "enum": ["metadata", "content"]
            },
            "offset": {
              "type": "integer",
              "minimum": 0
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            }
          },
          "required": ["runId", "evidenceId"]
        }
      },
      "required": ["name", "arguments"],
      "description": "读取指定运行已交付的证据；缺失或截断不能证明业务事实不存在。"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "browser_operation_get"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "operationId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 36,
              "format": "uuid"
            }
          },
          "required": ["operationId"]
        }
      },
      "required": ["name", "arguments"],
      "description": "查询原操作回执；不会重放操作。"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "verification_get_capabilities"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "entry": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192,
              "format": "uri",
              "pattern": "^https?://"
            },
            "executor": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": ["builtin", "external"]
                }
              },
              "required": ["kind"]
            }
          },
          "required": []
        }
      },
      "required": ["name", "arguments"],
      "description": "读取验证任务能力、预算和 Case 规则；第一阶段只支持 builtin。"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "verification_validate_cases"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[A-Za-z0-9_-]{1,80}$"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            },
            "cases": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "$ref": "verification-case-v2.schema.json"
              }
            },
            "executor": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": ["builtin", "external"]
                }
              },
              "required": ["kind"]
            }
          },
          "required": ["requestId", "cases"]
        }
      },
      "required": ["name", "arguments"],
      "description": "只校验并编译 Case，预览身份、分组、预算和证据计划；不创建任务、不分配账号或打开浏览器。"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "verification_submit_cases"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[A-Za-z0-9_-]{1,80}$"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            },
            "cases": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "$ref": "verification-case-v2.schema.json"
              }
            },
            "executor": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": ["builtin", "external"]
                }
              },
              "required": ["kind"]
            }
          },
          "required": ["requestId", "cases"]
        }
      },
      "required": ["name", "arguments"],
      "description": "原子提交完整 Case 请求给内置 Agent；可能操作业务数据。保持 requestId 重试，复用不表示重新验证。"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "verification_get_request"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[A-Za-z0-9_-]{1,80}$"
            },
            "view": {
              "enum": ["summary", "report"]
            },
            "cursor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "required": ["requestId"]
        }
      },
      "required": ["name", "arguments"],
      "description": "读取请求当前绑定的运行和部分或最终报告；返回重跑所需 requestRevision。"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "verification_get_run"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "runId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9_-]{1,160}$"
            },
            "view": {
              "enum": ["summary", "full"]
            },
            "cursor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "required": ["runId"]
        }
      },
      "required": ["name", "arguments"],
      "description": "读取指定验证运行的逐项结论、阻塞原因及清理结果；不隐式读取最新 Case 运行。"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "verification_cancel_run"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "runId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9_-]{1,160}$"
            },
            "operationId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 36,
              "format": "uuid"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "required": ["runId", "operationId"]
        }
      },
      "required": ["name", "arguments"],
      "description": "取消指定验证运行；可能影响同调用方共享该运行的请求，保留已交付证据。"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "verification_rerun_cases"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[A-Za-z0-9_-]{1,80}$"
            },
            "operationId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 36,
              "format": "uuid"
            },
            "expectedRequestRevision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "caseId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80,
                    "pattern": "^[A-Za-z0-9_-]{1,80}$"
                  },
                  "sourceRunId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160,
                    "pattern": "^[A-Za-z0-9_-]{1,160}$"
                  },
                  "runKey": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80,
                    "pattern": "^[A-Za-z0-9_-]{1,80}$"
                  }
                },
                "required": ["caseId", "sourceRunId", "runKey"]
              }
            },
            "executor": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": ["builtin"]
                }
              },
              "required": ["kind"]
            },
            "budgetMode": {
              "enum": ["current", "original"]
            },
            "timeBudget": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "stepTimeoutMs": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 86400000
                },
                "cleanupTimeoutMs": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 86400000
                }
              },
              "required": [],
              "minProperties": 1
            }
          },
          "required": [
            "requestId",
            "operationId",
            "expectedRequestRevision",
            "items"
          ]
        }
      },
      "required": ["name", "arguments"],
      "description": "以明确来源运行和请求版本原子重跑所选 Case；新运行会重新操作业务数据，网络重试必须复用 operationId 与 runKey。"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "verification_read_evidence"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "runId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9_-]{1,160}$"
            },
            "evidenceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]{1,128}$"
            },
            "representation": {
              "enum": ["metadata", "content"]
            },
            "offset": {
              "type": "integer",
              "minimum": 0
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            }
          },
          "required": ["runId", "evidenceId"]
        }
      },
      "required": ["name", "arguments"],
      "description": "读取指定验证运行已交付的证据，不跨运行借用证据。"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "verification_operation_get"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "operationId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 36,
              "format": "uuid"
            }
          },
          "required": ["operationId"]
        }
      },
      "required": ["name", "arguments"],
      "description": "查询取消或重跑的持久回执；回执丢失时先查询原操作。"
    }
  ]
}
