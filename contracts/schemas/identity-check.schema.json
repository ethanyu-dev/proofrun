{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "method": {
      "enum": ["text", "absent", "manual"]
    },
    "value": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "required": ["id", "description", "method"],
  "allOf": [
    {
      "if": {
        "properties": {
          "method": {
            "enum": ["text", "absent"]
          }
        }
      },
      "then": {
        "required": ["value"],
        "properties": {
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    }
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://proofrun.invalid/contracts/0.1/identity-check.schema.json",
  "title": "IdentityCheck",
  "description": "显式前置条件；文本检查使用完整观察，人工条件只能由当前会话的人工确认满足。"
}
