{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "taskId",
    "objective",
    "environment",
    "target",
    "acceptanceCriteria",
    "budget"
  ],
  "properties": {
    "caseDefinition": {
      "$ref": "verification-case.schema.json",
      "description": "case 入口保存的原始业务定义，用于幂等重提和隔离公开读取；普通内部任务省略。"
    },
    "protocolVersion": {
      "const": "0.1"
    },
    "taskId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "上层生成的不可变任务身份，也用于 HTTP 路径；相同身份只能提交相同定义。"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nodePool"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "nodePool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "与节点注册一致的内网资源池标识。"
        },
        "allowIntervention": {
          "type": "boolean",
          "description": "是否允许人工辅助；等待计入原任务预算，人工不能修改验收标准。"
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "stateId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$",
              "description": "节点私有登录状态名称，不是路径。"
            },
            "restore": {
              "type": "boolean",
              "description": "是否要求载入已有状态；首次人工登录时设为 false。"
            },
            "nodeId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$",
              "description": "登录状态所属节点，调度固定到此节点。"
            }
          },
          "required": ["nodeId", "stateId", "restore"]
        },
        "reuseAuth": {
          "type": "boolean",
          "description": "是否按环境和目标站点自动复用节点登录快照；未指定时跟随 allowIntervention。显式 auth 配置优先。"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        }
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "expectedResult", "evidenceKinds"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "expectedResult": {
            "type": "string",
            "minLength": 1
          },
          "evidenceKinds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["DOM", "SCREENSHOT", "NETWORK", "TRACE"]
            }
          },
          "stepId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$",
            "description": "结构化任务中所属步骤身份。"
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeoutMs", "maxActions"],
      "properties": {
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "maxActions": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "arm", "sourceTaskId"],
      "description": "控制面原子创建的双组对比身份；两组业务目标与预算一致，分别占用独立会话。",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "arm": {
          "enum": ["llm", "jev"]
        },
        "sourceTaskId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        }
      }
    },
    "executionMode": {
      "enum": ["parallel", "llm", "jev"],
      "description": "执行方式：parallel 原子创建纯 LLM 与 LLM + JEV 两组；llm、jev 各运行一个任务。省略时兼容旧任务，按 comparison.arm 或纯 LLM 执行。"
    },
    "caseV2Definition": {
      "$ref": "verification-case-v2.schema.json",
      "description": "v2 原始业务定义，冻结用于幂等比较。"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "case-step.schema.json"
      },
      "description": "服务端规范化的串行步骤；每项均有稳定 stepId。"
    },
    "purpose": {
      "enum": ["verification", "cleanup"],
      "description": "清理是独立内部任务，不扩展公开步骤类型。"
    },
    "parentTaskId": {
      "type": "string",
      "description": "清理任务关联的原任务身份。"
    },
    "resourceKey": {
      "type": "string",
      "description": "平台生成的任务及业务上下文互斥键；主任务与其清理共享，不同 caseId 独立。"
    },
    "cleanupBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeoutMs", "maxActions"],
      "properties": {
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "maxActions": {
          "type": "integer",
          "minimum": 1
        }
      },
      "description": "v2 首次提交冻结的独立清理预算；历史任务缺失时沿用主任务预算。"
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://proofrun.invalid/contracts/0.1/verification-task.schema.json",
  "title": "VerificationTask",
  "description": "平台内部任务结构，含环境、调度和执行配置；外部调用使用 VerificationCase。",
  "allOf": [
    {
      "if": {
        "properties": {
          "purpose": {
            "const": "cleanup"
          }
        },
        "required": ["purpose"]
      },
      "then": {
        "required": ["steps", "parentTaskId"],
        "properties": {
          "steps": {},
          "parentTaskId": {}
        }
      },
      "else": {
        "properties": {
          "acceptanceCriteria": {
            "minItems": 1,
            "type": "array"
          }
        }
      }
    }
  ]
}
