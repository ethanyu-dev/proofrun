{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "taskId",
    "objective",
    "environment",
    "target",
    "acceptanceCriteria",
    "budget"
  ],
  "properties": {
    "caseDefinition": {
      "$ref": "verification-case.schema.json",
      "description": "case 入口保存的原始业务定义，用于幂等重提和隔离公开读取；普通内部任务省略。"
    },
    "protocolVersion": {
      "const": "0.1"
    },
    "taskId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "上层生成的不可变任务身份，也用于 HTTP 路径；相同身份只能提交相同定义。"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nodePool"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "nodePool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "与节点注册一致的内网资源池标识。"
        },
        "allowIntervention": {
          "type": "boolean",
          "description": "是否允许人工辅助；等待暂停执行时限，完成后重新计时二十分钟，人工不能修改验收标准。"
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "stateId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$",
              "description": "节点私有登录状态名称，不是路径。"
            },
            "restore": {
              "type": "boolean",
              "description": "已退役的恢复开关，仅用于读取历史定义，不触发登录恢复。"
            },
            "nodeId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$",
              "description": "登录状态所属节点，调度固定到此节点。"
            }
          },
          "required": ["nodeId", "stateId", "restore"],
          "deprecated": true,
          "description": "历史登录槽元数据；不恢复或保存状态，仅保留显式 nodeId 的路由约束。"
        },
        "reuseAuth": {
          "type": "boolean",
          "description": "已退役的自动登录复用开关，仅为历史结构兼容，不触发恢复、保存或节点偏好。",
          "deprecated": true
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        }
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "expectedResult", "evidenceKinds"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "expectedResult": {
            "type": "string",
            "minLength": 1
          },
          "evidenceKinds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["DOM", "SCREENSHOT", "NETWORK", "TRACE"]
            }
          },
          "stepId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$",
            "description": "结构化任务中所属步骤身份。"
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeoutMs", "maxActions"],
      "properties": {
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "maxActions": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "arm", "sourceTaskId"],
      "description": "历史双组对比身份，仅供读取原执行记录；新任务不接受此字段，重跑创建 LLM 单组。",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "arm": {
          "enum": ["llm", "jev"]
        },
        "sourceTaskId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        }
      }
    },
    "executionMode": {
      "enum": ["parallel", "llm", "jev"],
      "description": "新建及重跑仅支持 llm，省略时按纯 LLM 执行。jev、parallel 仅保留用于读取历史记录，不能用于新执行。"
    },
    "caseV2Definition": {
      "$ref": "verification-case-v2.schema.json",
      "description": "v2 原始业务定义，冻结用于幂等比较。"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "case-step.schema.json"
      },
      "description": "服务端规范化的串行步骤；每项均有稳定 stepId。"
    },
    "purpose": {
      "enum": ["verification", "cleanup"],
      "description": "兼容历史独立清理任务；新 case 的清理使用同任务末尾步骤。"
    },
    "parentTaskId": {
      "type": "string",
      "description": "清理任务关联的原任务身份。"
    },
    "resourceKey": {
      "type": "string",
      "description": "仅保留历史任务的互斥键用于读取；新任务禁止提交，当前调度不使用资源锁。"
    },
    "cleanupBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeoutMs", "maxActions"],
      "properties": {
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "maxActions": {
          "type": "integer",
          "minimum": 1
        }
      },
      "description": "历史独立清理的冻结预算；新 case 不再设置此字段，所有步骤共享 budget。"
    },
    "cleanupStepIds": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,80}$"
      },
      "description": "同一任务末尾的业务清理步骤身份；存在时不再创建独立清理任务。"
    },
    "stepBudget": {
      "type": "object",
      "additionalProperties": false,
      "description": "按步骤独立冻结的预算；缺失时保留旧任务总预算语义。清理共享独立额度。",
      "required": ["version", "steps", "cleanup", "settleMs"],
      "properties": {
        "version": {
          "const": 1
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["timeoutMs", "maxActions", "maxModelCalls", "stepId"],
            "properties": {
              "timeoutMs": {
                "type": "integer",
                "minimum": 1
              },
              "maxActions": {
                "type": "integer",
                "minimum": 0
              },
              "maxModelCalls": {
                "type": "integer",
                "minimum": 0
              },
              "stepId": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "cleanup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["timeoutMs", "maxActions", "maxModelCalls"],
          "properties": {
            "timeoutMs": {
              "type": "integer",
              "minimum": 1
            },
            "maxActions": {
              "type": "integer",
              "minimum": 0
            },
            "maxModelCalls": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "settleMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120000,
          "description": "每步结束允许在途操作完成和持久化的额外时间，不可用于派发新操作。"
        }
      }
    },
    "sessionPlan": {
      "$ref": "session-plan.schema.json"
    },
    "profilePlan": {
      "type": "object",
      "additionalProperties": false,
      "description": "一个执行拥有一个 profile，各 setup 分组独占标签页；旧任务缺省时保持串行语义。",
      "properties": {
        "version": {
          "const": 1
        },
        "maxConcurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,80}$"
              },
              "stepIds": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,80}$"
                }
              }
            },
            "required": ["id", "stepIds"]
          }
        },
        "environmentGateStepId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$",
          "description": "新任务首个 setup 核实共享环境后才启动其他组；缺省保持历史并发行为。"
        }
      },
      "required": ["version", "maxConcurrency", "groups"]
    },
    "executionPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "environment", "evidenceKinds"],
      "properties": {
        "version": {
          "const": 1
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "source", "basis", "resolverVersion"],
          "properties": {
            "mode": {
              "enum": ["guest", "configured"]
            },
            "source": {
              "enum": ["explicit", "inferred", "default"]
            },
            "basis": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "string",
                "maxLength": 2000
              }
            },
            "resolverVersion": {
              "const": 1
            }
          }
        },
        "evidenceKinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["DOM", "SCREENSHOT", "NETWORK", "TRACE"]
          }
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://proofrun.invalid/contracts/0.1/verification-task.schema.json",
  "title": "VerificationTask",
  "description": "平台内部任务结构，含环境、调度和执行配置；外部调用使用 VerificationCase。",
  "allOf": [
    {
      "if": {
        "properties": {
          "purpose": {
            "const": "cleanup"
          }
        },
        "required": ["purpose"]
      },
      "then": {
        "required": ["steps", "parentTaskId"],
        "properties": {
          "steps": {},
          "parentTaskId": {}
        }
      },
      "else": {
        "properties": {
          "acceptanceCriteria": {
            "minItems": 1,
            "type": "array"
          }
        }
      }
    }
  ]
}
