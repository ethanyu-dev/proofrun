{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://proofrun.invalid/contracts/0.1/browser-task-request.schema.json",
  "title": "BrowserTaskRequest",
  "description": "浏览器任务只接收业务输入和客户端生成的稳定重试身份；执行配置由服务端冻结。",
  "type": "object",
  "additionalProperties": false,
  "required": ["taskId", "url", "objective"],
  "properties": {
    "taskId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,100}$",
      "description": "客户端生成的稳定身份；相同身份只接受相同业务输入，失败重试必须复用。"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "maxLength": 8192,
      "description": "浏览器首次访问的 HTTP(S) 入口，不隐含最终地址约束。"
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000,
      "pattern": "\\S",
      "description": "完整保留用户要求的操作、查询和交付内容；不推导额外验收项。"
    }
  }
}
