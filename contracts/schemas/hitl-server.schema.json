{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HitlServer",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "state"
        },
        "taskId": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mode": {
          "enum": ["REQUESTED", "HUMAN"]
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "canSaveAuth": {
          "type": "boolean"
        },
        "targetUrl": {
          "type": "string",
          "format": "uri",
          "description": "任务目标地址，Cookie 写入仅允许该 origin。"
        },
        "conditionKeys": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "finalizing": {
          "type": "boolean",
          "description": "节点已冻结输入，等待控制面确认完成。"
        }
      },
      "required": [
        "type",
        "taskId",
        "reason",
        "items",
        "mode",
        "expiresAt",
        "canSaveAuth"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "frame"
        },
        "data": {
          "type": "string",
          "maxLength": 2097152
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 16384
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 16384
        },
        "capturedAt": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["type", "data", "width", "height"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "error"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": ["type", "code", "message"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "result"
        },
        "commandId": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "effect": {
          "type": "string"
        }
      },
      "required": ["type", "commandId", "status", "effect"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "completed"
        },
        "authStatus": {
          "enum": ["saved", "newer", "disabled"],
          "description": "已保存、保留其他会话更新的快照、或未启用登录复用。"
        }
      },
      "required": ["type"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "unable"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": ["type", "reason"]
    }
  ]
}
