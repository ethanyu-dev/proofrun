{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://proofrun.invalid/contracts/0.1/node-list.schema.json",
  "title": "NodeList",
  "type": "object",
  "description": "管理员节点视图，不包含机器凭据和凭据摘要。",
  "additionalProperties": false,
  "required": ["nodes"],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "会话占用取节点上报与控制面未确认关闭会话的并集，仅供展示；资源准入由节点决定。",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "pool",
          "node_epoch",
          "capabilities",
          "inventory",
          "last_seen_at",
          "revoked_at",
          "online",
          "occupied",
          "routing_domains",
          "routing_revision"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "pool": {
            "type": "string"
          },
          "node_epoch": {
            "type": ["string", "null"]
          },
          "capabilities": {
            "type": "object"
          },
          "inventory": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "last_seen_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "revoked_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "online": {
            "type": "boolean"
          },
          "occupied": {
            "type": "integer",
            "minimum": 0
          },
          "routing_domains": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "当前节点在其资源池内绑定的完整域名或 *.example.com 通配符规则。"
          },
          "routing_revision": {
            "type": "integer",
            "minimum": 0,
            "description": "域名配置编辑版本。"
          },
          "runtime": {
            "anyOf": [
              {
                "$ref": "node-runtime.schema.json"
              },
              {
                "type": "null"
              }
            ],
            "description": "最近心跳上报的进程版本；未上报时为 null，离线节点仅代表最后一次上报。"
          },
          "public_url": {
            "type": ["string", "null"]
          },
          "admission": {
            "type": ["object", "null"],
            "properties": {
              "accepting": {
                "type": "boolean"
              },
              "reason": {
                "type": "string"
              },
              "cpuPercent": {
                "type": "number",
                "minimum": 0
              },
              "availableBytes": {
                "type": "integer",
                "minimum": 0
              },
              "reserveBytes": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "default_profile": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
              "version": {
                "type": "string",
                "pattern": "^[a-f0-9-]{36}$"
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time"
              },
              "sessionId": {
                "type": "string",
                "maxLength": 128
              }
            },
            "required": ["version", "updatedAt", "sessionId"],
            "description": "节点已发布的默认模板元数据；不包含登录材料。空值表示尚未初始化。"
          }
        },
        "title": "NodeSummary"
      }
    }
  }
}
