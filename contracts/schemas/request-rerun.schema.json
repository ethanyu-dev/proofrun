{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://proofrun.invalid/contracts/0.1/request-rerun.schema.json",
  "title": "RequestRerun",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$",
      "description": "可选的旧版新请求身份；省略时在原请求内新增运行，重试沿用 caseIds。"
    },
    "caseIds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sourceCaseId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$",
            "description": "整请求重跑对应的原 case；普通提交为 null。"
          },
          "caseId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$",
            "description": "旧客户端兼容字段，仅作为运行幂等键，不再创建新 case。"
          },
          "runId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$",
            "description": "新运行幂等键；重试保持不变，caseId 不改变。"
          }
        },
        "required": ["sourceCaseId"],
        "oneOf": [
          {
            "required": ["runId"],
            "properties": {
              "runId": {}
            }
          },
          {
            "required": ["caseId"],
            "properties": {
              "caseId": {}
            }
          }
        ]
      },
      "minItems": 1,
      "maxItems": 32,
      "description": "原请求内待重跑的 case 与新运行映射；可选一个或全部成员，服务端原子提交。指定新 requestId 时必须覆盖全部成员。"
    },
    "budgetMode": {
      "enum": ["current", "original"],
      "description": "current 使用当前预算；original 沿用来源预算。"
    },
    "timeBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stepTimeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000,
          "description": "每个业务步骤的时间下限，毫秒；不缩短原等待。"
        },
        "cleanupTimeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000,
          "description": "整段清理的时间下限，毫秒。"
        }
      },
      "required": [],
      "description": "只增加时间下限，不改变动作与模型额度。",
      "minProperties": 1
    }
  },
  "required": ["caseIds"]
}
