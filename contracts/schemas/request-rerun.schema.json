{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://proofrun.invalid/contracts/0.1/request-rerun.schema.json",
  "title": "RequestRerun",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$",
      "description": "逻辑提交的稳定身份；重试沿用，重跑使用新身份。"
    },
    "caseIds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sourceCaseId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$",
            "description": "整请求重跑对应的原 case；普通提交为 null。"
          },
          "caseId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$",
            "description": "全局 case 幂等身份，不改为请求内局部身份。"
          }
        },
        "required": ["sourceCaseId", "caseId"]
      },
      "minItems": 1,
      "maxItems": 32,
      "description": "完整旧新身份映射，由服务端校验覆盖和唯一性。"
    },
    "budgetMode": {
      "enum": ["current", "original"],
      "description": "current 使用当前预算；original 沿用来源预算。"
    },
    "timeBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stepTimeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000,
          "description": "每个业务步骤的时间下限，毫秒；不缩短原等待。"
        },
        "cleanupTimeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000,
          "description": "整段清理的时间下限，毫秒。"
        }
      },
      "required": [],
      "description": "只增加时间下限，不改变动作与模型额度。",
      "minProperties": 1
    }
  },
  "required": ["requestId", "caseIds"]
}
