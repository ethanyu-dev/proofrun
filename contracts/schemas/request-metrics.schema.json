{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://proofrun.invalid/contracts/0.1/request-metrics.schema.json",
  "title": "RequestMetrics",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "executionElapsedMs": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "关联执行首次领取到最后任务结束的墙钟跨度，含人工等待、组间等待与清理，不含首次排队；复用任务沿用原时间。"
    },
    "execution": {
      "$ref": "token-usage.schema.json",
      "description": "所有关联验证执行的已采集用量，按任务去重，包含独立清理。"
    },
    "llm": {
      "$ref": "token-usage.schema.json",
      "description": "验证中的文本决策和填写调用。"
    },
    "totalTokens": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "验证执行已采集 Tokens 的合计。"
    }
  },
  "required": ["executionElapsedMs", "execution", "llm", "totalTokens"]
}
