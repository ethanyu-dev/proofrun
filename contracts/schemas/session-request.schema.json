{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "mode": {
      "enum": ["auto", "guest", "manual", "external"]
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "identity-check.schema.json"
      },
      "maxItems": 32
    },
    "external": {
      "$ref": "external-account-selector.schema.json"
    }
  },
  "required": ["mode"],
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "external"
          }
        }
      },
      "then": {
        "required": ["external", "requirements"],
        "properties": {
          "requirements": {
            "type": "array",
            "items": {
              "$ref": "identity-check.schema.json"
            },
            "maxItems": 32,
            "minItems": 1
          },
          "external": {
            "$ref": "external-account-selector.schema.json"
          }
        }
      },
      "else": {
        "if": {
          "properties": {
            "mode": {
              "const": "auto"
            }
          }
        },
        "then": {},
        "else": {
          "properties": {
            "external": false
          }
        }
      }
    }
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://proofrun.invalid/contracts/0.1/session-request.schema.json",
  "title": "SessionRequest",
  "description": "省略或 auto 时按 case 自动准备身份，优先 DevPass、无账号则人工介入；可显式约束身份，禁止携带密码或 Cookie。"
}
