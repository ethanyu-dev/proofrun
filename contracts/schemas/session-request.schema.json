{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "mode": {
      "enum": ["guest", "manual", "external"]
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "identity-check.schema.json"
      },
      "maxItems": 32
    },
    "external": {
      "$ref": "external-account-selector.schema.json"
    }
  },
  "required": ["mode"],
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "external"
          }
        }
      },
      "then": {
        "required": ["external", "requirements"],
        "properties": {
          "requirements": {
            "type": "array",
            "items": {
              "$ref": "identity-check.schema.json"
            },
            "maxItems": 32,
            "minItems": 1
          },
          "external": {
            "$ref": "external-account-selector.schema.json"
          }
        }
      },
      "else": {
        "properties": {
          "external": false
        }
      }
    }
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://proofrun.invalid/contracts/0.1/session-request.schema.json",
  "title": "SessionRequest",
  "description": "只支持访客、当前会话人工登录和 DevPass 外部账号；禁止携带密码或 Cookie。"
}
