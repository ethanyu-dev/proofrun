{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "taskId",
    "lifecycle",
    "executionDisposition",
    "verdict",
    "summary",
    "criteria",
    "artifacts"
  ],
  "properties": {
    "protocolVersion": {
      "const": "0.1"
    },
    "taskId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "lifecycle": {
      "enum": ["COMPLETED", "CANCELLED", "TIMED_OUT"]
    },
    "executionDisposition": {
      "enum": ["EXECUTED", "BLOCKED", "ERROR"]
    },
    "verdict": {
      "enum": ["PASSED", "FAILED", "INCONCLUSIVE", null]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterionId", "verdict", "summary", "evidenceRefs"],
        "properties": {
          "criterionId": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "enum": ["PASSED", "FAILED", "INCONCLUSIVE", "SKIPPED"]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidenceRefs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "verdict": {
                  "enum": ["PASSED", "FAILED"]
                }
              },
              "required": ["verdict"]
            },
            "then": {
              "properties": {
                "evidenceRefs": {
                  "type": "array",
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "uri", "sha256"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": ["DOM", "SCREENSHOT", "NETWORK", "TRACE"]
          },
          "uri": {
            "type": "string",
            "format": "uri"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "executionDetails": {
      "title": "ExecutionDetails",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reasonCode": {
          "type": ["string", "null"],
          "description": "机器可读的执行结束原因；正常验收可为 null。"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "配置的模型名称，不包含 API 地址或凭据。"
        },
        "modelCalls": {
          "type": "integer",
          "minimum": 0,
          "description": "实际发起的模型请求次数。"
        },
        "actions": {
          "type": "integer",
          "minimum": 0,
          "description": "提交的浏览器写动作数，包含初次导航。"
        },
        "elapsedMs": {
          "type": "integer",
          "minimum": 0,
          "description": "从领取到生成报告的耗时。"
        },
        "commandIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "可追溯到控制面结果的命令身份。"
          },
          "description": "按提交顺序记录命令，HTTP 重送不添加新身份。"
        },
        "promptTokens": {
          "type": "integer",
          "minimum": 0,
          "description": "已解析工具回复中的输入 token 计数；缺失 usage 的调用不计入。"
        },
        "completionTokens": {
          "type": "integer",
          "minimum": 0,
          "description": "已解析工具回复中的输出 token 计数；不能作为完整账单。"
        },
        "modelUsage": {
          "type": "array",
          "description": "按实际提供者分别累计请求与已返回的用量；不是账单。",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["model", "calls", "promptTokens", "completionTokens"],
            "properties": {
              "model": {
                "type": "string"
              },
              "calls": {
                "type": "integer",
                "minimum": 0
              },
              "promptTokens": {
                "type": "integer",
                "minimum": 0
              },
              "completionTokens": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      },
      "required": [
        "reasonCode",
        "model",
        "modelCalls",
        "actions",
        "elapsedMs",
        "commandIds",
        "promptTokens",
        "completionTokens"
      ]
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "step-result.schema.json"
      },
      "description": "结构化任务的逐步执行事实；异常终止仍保留已完成验收。"
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://proofrun.invalid/contracts/0.1/verification-report.schema.json",
  "title": "VerificationReport",
  "description": "平台内部执行报告；外部读取 CaseResult。结构有效不代表业务判断已被独立证实。",
  "allOf": [
    {
      "if": {
        "properties": {
          "executionDisposition": {
            "const": "EXECUTED"
          }
        },
        "required": ["executionDisposition"]
      },
      "then": {
        "properties": {
          "lifecycle": {
            "const": "COMPLETED"
          },
          "verdict": {
            "enum": ["PASSED", "FAILED", "INCONCLUSIVE"]
          }
        }
      },
      "else": {
        "properties": {
          "verdict": {
            "type": "null"
          }
        },
        "allOf": [
          {
            "if": {
              "not": {
                "required": ["steps"],
                "properties": {
                  "steps": {}
                }
              }
            },
            "then": {
              "properties": {
                "criteria": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "verdict": {
                        "const": "SKIPPED"
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  ]
}
