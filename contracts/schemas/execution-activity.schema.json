{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "actor": {
            "enum": ["AGENT", "HUMAN"]
          },
          "action": {
            "type": ["string", "null"]
          },
          "status": {
            "type": ["string", "null"]
          },
          "effect": {
            "type": ["string", "null"]
          },
          "error": {
            "type": ["string", "null"]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "kind",
          "actor",
          "action",
          "status",
          "effect",
          "error",
          "created_at"
        ]
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mode": {
            "enum": ["AUTO", "REQUESTED", "HUMAN"]
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "reason": {
            "type": ["string", "null"]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["mode", "revision", "reason", "created_at"]
      }
    },
    "observation": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "observationId": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "targets": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "target": {
                    "type": "string"
                  },
                  "role": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "required": ["target", "role", "name"]
              }
            }
          },
          "required": ["observationId", "text", "targets"]
        }
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": ["DOM", "SCREENSHOT", "NETWORK", "RUNTIME", "TRACE"]
          },
          "sha256": {
            "type": "string"
          }
        },
        "required": ["id", "kind", "sha256"]
      }
    },
    "limit": {
      "type": "integer",
      "minimum": 1
    },
    "renewals": {
      "description": "最近续租投递与节点确认的诊断；不含执行令牌或完整信封。",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "sentAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "status": {
            "type": ["string", "null"]
          },
          "error": {
            "type": ["string", "null"]
          },
          "requestedTtlMs": {
            "type": ["integer", "null"]
          },
          "grantAgeMs": {
            "type": ["integer", "null"]
          },
          "leaseRemainingMs": {
            "type": ["integer", "null"]
          }
        },
        "required": [
          "id",
          "createdAt",
          "sentAt",
          "status",
          "error",
          "requestedTtlMs",
          "grantAgeMs",
          "leaseRemainingMs"
        ]
      }
    }
  },
  "required": ["commands", "events", "observation", "artifacts", "limit"],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExecutionActivity",
  "description": "管理员读取近期执行事实；不包含动作输入值或执行令牌。"
}
