{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExecutionGrant",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "执行身份。"
    },
    "task": {
      "$ref": "verification-task.schema.json",
      "description": "上层提交的不可变定义。"
    },
    "leaseToken": {
      "type": "string",
      "minLength": 1,
      "description": "仅本次执行可用的权限，不进入模型上下文。"
    },
    "leaseExpiresAt": {
      "type": "string",
      "format": "date-time",
      "description": "当前 worker 权限期限。"
    },
    "taskDeadlineAt": {
      "type": "string",
      "format": "date-time",
      "description": "初始执行截止时间；人工暂停及恢复后以控制面视图为准。"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "description": "平台预留的会话。"
    },
    "nodeId": {
      "type": "string",
      "minLength": 1,
      "description": "平台选中的节点。"
    },
    "state": {
      "const": "STARTING"
    },
    "runtimeVersion": {
      "const": 1,
      "description": "存在时必须使用内部运行时接口；省略为旧 worker 驱动路径。"
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "caseId"],
      "properties": {
        "runId": {
          "type": "string"
        },
        "caseId": {
          "type": "string"
        }
      },
      "description": "由调度器根据持久化关联生成，不接受任务输入自行开启故障注入。"
    }
  },
  "required": [
    "id",
    "task",
    "leaseToken",
    "leaseExpiresAt",
    "taskDeadlineAt",
    "sessionId",
    "nodeId",
    "state"
  ]
}
