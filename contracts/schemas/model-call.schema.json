{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://proofrun.invalid/contracts/0.1/model-call.schema.json",
  "title": "ModelCall",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$",
      "description": "一次真实模型 HTTP 请求的稳定身份，重试产生新的调用记录。"
    },
    "callIndex": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20000,
      "description": "当前执行内的模型请求顺序；历史混合策略的子请求也单独计数。"
    },
    "decisionIndex": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20000,
      "description": "执行循环的决策轮次；新循环每轮至多一个模型请求。"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "实际发送的模型名称。"
    },
    "purpose": {
      "enum": ["DECISION", "FIELD_VALUE"],
      "description": "新调用只接受 DECISION；FIELD_VALUE 仅供单 LLM 历史调用记录解码。"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "description": "worker 在派发请求前记录的时间。"
    },
    "finishedAt": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "worker 收到回复或错误的时间，未收到回执时为空。"
    },
    "status": {
      "enum": ["PENDING", "RECEIVED", "ERROR"],
      "description": "仅表示请求接收状态，收到回复不等于模型决定有效或业务验收通过。"
    },
    "request": {
      "type": ["string", "null"],
      "maxLength": 1200000,
      "description": "实际请求正文 JSON，图片 base64 替换为证据引用；保留策略清理后为空。"
    },
    "requestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "原始请求正文（含图片）的摘要，用于比对派发内容。"
    },
    "response": {
      "type": ["string", "null"],
      "maxLength": 600000,
      "description": "供应商返回的 model、choices、usage 字段 JSON；历史调用可含 answers，未接收或清理后为空。"
    },
    "error": {
      "type": ["string", "null"],
      "maxLength": 200,
      "description": "稳定错误码，不保存带地址或凭据的原始异常文本。"
    },
    "promptTokens": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "供应商返回的输入用量，未报告则为空。"
    },
    "completionTokens": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "供应商返回的输出用量，未报告则为空。"
    },
    "elapsedMs": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "一次供应商请求的耗时，不含记录交付。"
    },
    "imagesOmitted": {
      "type": "integer",
      "minimum": 0,
      "description": "正文中被替换为证据引用的图片数量。"
    },
    "archived": {
      "type": "boolean",
      "description": "正文是否已按任务保留策略清理。"
    },
    "stepId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "description": "当前决策纠错链的实际尝试次数，由执行器记录；缺失的历史记录不推算。"
    },
    "maxAttempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "description": "连续决策错误上限；不承诺剩余预算足够执行下一次重试。"
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600000,
      "description": "派发前计算的单次请求时限上限；存档后仍按剩余步骤期限收紧，不延长执行预算。"
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "description": "封闭诊断字段，不包含原始正文、地址、认证头或任意供应商文本。",
      "properties": {
        "phase": {
          "enum": ["REQUEST", "RESPONSE_BODY", "RESPONSE_PARSE", "HTTP_STATUS"],
          "description": "失败发生阶段；REQUEST 不能进一步区分建连与等待响应头。"
        },
        "httpStatus": {
          "type": ["integer", "null"],
          "minimum": 100,
          "maximum": 599,
          "description": "已收到的 HTTP 状态；未收到响应头时为空。"
        },
        "contentType": {
          "enum": [
            "application/json",
            "text/html",
            "text/plain",
            "other",
            null
          ],
          "description": "归一化响应媒体类型；不保存原始头参数，缺失时为空。"
        },
        "responseFormat": {
          "enum": ["json", "html", "text", "empty", "unknown"],
          "description": "已读完整正文的结构类别，未读完时为 unknown。"
        },
        "responseBytes": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "已完整读取的响应字节数；未读完或超限时为空。"
        },
        "reason": {
          "enum": [
            "RATE_LIMITED",
            "GATEWAY_TIMEOUT",
            "UPSTREAM_UNAVAILABLE",
            "AUTH_REJECTED",
            "CONTEXT_LIMIT",
            "INVALID_RESPONSE",
            "REQUEST_TIMEOUT",
            "TRANSPORT_FAILURE",
            "RESPONSE_TOO_LARGE"
          ],
          "description": "按状态及有限特征生成的分类摘要，不复制供应商错误消息。"
        }
      },
      "required": [
        "phase",
        "httpStatus",
        "contentType",
        "responseFormat",
        "responseBytes",
        "reason"
      ]
    }
  },
  "required": [
    "id",
    "callIndex",
    "decisionIndex",
    "model",
    "purpose",
    "startedAt",
    "finishedAt",
    "status",
    "request",
    "requestSha256",
    "response",
    "error",
    "promptTokens",
    "completionTokens",
    "elapsedMs",
    "imagesOmitted",
    "archived"
  ]
}
