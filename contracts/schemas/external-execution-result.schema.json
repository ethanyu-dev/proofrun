{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExternalExecutionResult",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "operation"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "operationId": {
              "type": "string",
              "format": "uuid"
            },
            "controllerId": {
              "type": "string"
            },
            "runId": {
              "type": "string"
            },
            "status": {
              "enum": ["RUNNING", "SUCCEEDED", "FAILED", "UNKNOWN"]
            },
            "progressApplied": {
              "type": "boolean"
            },
            "effect": {
              "enum": ["UNKNOWN", "NOT_STARTED", "OBSERVED", "APPLIED"]
            },
            "error": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "type": "string"
                    }
                  },
                  "required": ["code"]
                }
              ]
            }
          },
          "required": [
            "operationId",
            "controllerId",
            "runId",
            "status",
            "progressApplied",
            "effect",
            "error"
          ]
        }
      },
      "required": ["kind", "data"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "controller"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "controllerId": {
              "type": "string"
            },
            "runId": {
              "type": "string"
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            },
            "state": {
              "enum": ["ACTIVE", "CLOSED", "EXPIRED", "LOST"]
            },
            "runState": {
              "type": "string"
            },
            "sessionState": {
              "type": "string"
            },
            "controlMode": {
              "type": "string"
            },
            "idleDeadlineAt": {
              "type": "string",
              "format": "date-time"
            },
            "closureVerified": {
              "type": "boolean"
            },
            "pendingOperation": {
              "type": ["string", "null"]
            },
            "context": {
              "type": ["object", "null"],
              "description": "共享执行器的有界上下文投影；budget 使用 decisionCalls，不公开内部租约。"
            },
            "allowedActions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "nextAction": {
              "enum": ["READ_REPORT", "HUMAN_REQUIRED", "ACT", "WAIT"]
            },
            "executor": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "external"
                },
                "judgmentSource": {
                  "const": "external_agent"
                },
                "usageSource": {
                  "const": "unavailable"
                },
                "decisionCalls": {
                  "type": "integer",
                  "minimum": 0
                },
                "modelCalls": {
                  "type": "null"
                },
                "promptTokens": {
                  "type": "null"
                },
                "completionTokens": {
                  "type": "null"
                }
              },
              "required": [
                "kind",
                "judgmentSource",
                "usageSource",
                "decisionCalls",
                "modelCalls",
                "promptTokens",
                "completionTokens"
              ]
            },
            "report": {
              "type": ["object", "null"],
              "description": "共享报告构建器校验并产生的结果；未完成时可以为空。"
            }
          },
          "required": [
            "controllerId",
            "runId",
            "revision",
            "state",
            "runState",
            "sessionState",
            "controlMode",
            "idleDeadlineAt",
            "closureVerified",
            "pendingOperation",
            "context",
            "allowedActions",
            "nextAction",
            "executor",
            "report"
          ]
        }
      },
      "required": ["kind", "data"]
    }
  ]
}
