{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HitlClient",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "authenticate"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "token": {
          "type": "string",
          "minLength": 32,
          "maxLength": 256
        }
      },
      "required": ["type", "id", "token"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "command"
        },
        "commandId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "command": {
          "$ref": "node-command.schema.json#/properties/command"
        }
      },
      "required": ["type", "commandId", "command"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "complete"
        },
        "confirmedItems": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 10,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9
          },
          "description": "人工明确勾选的待办序号，与本次交接绑定。"
        }
      },
      "required": ["type"]
    }
  ]
}
