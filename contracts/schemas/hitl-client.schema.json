{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HitlClient",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "authenticate"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "token": {
          "type": "string",
          "minLength": 32,
          "maxLength": 512,
          "description": "控制面返回且已在节点安装摘要的短期直连凭据；不得传入管理员、机器或长期处理链接令牌。"
        },
        "nodeId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$",
          "description": "API 返回的绑定节点身份；显式多控制面绑定必须提供，仅用于路由，不代替凭证。"
        }
      },
      "required": ["type", "id", "token"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "command"
        },
        "commandId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "command": {
          "$ref": "node-command.schema.json#/properties/command"
        }
      },
      "required": ["type", "commandId", "command"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "complete"
        },
        "confirmedItems": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 10,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9
          },
          "description": "人工明确勾选的待办序号，与本次交接绑定。"
        },
        "confirmedConditionKeys": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "required": ["type"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "unable"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": ["type", "reason"]
    }
  ]
}
