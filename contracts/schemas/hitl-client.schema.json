{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HitlClient",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "authenticate"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "token": {
          "type": "string",
          "minLength": 32,
          "maxLength": 256
        }
      },
      "required": ["type", "id", "token"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "command"
        },
        "commandId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "command": {
          "$ref": "node-command.schema.json#/properties/command"
        }
      },
      "required": ["type", "commandId", "command"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "complete"
        }
      },
      "required": ["type"]
    }
  ]
}
