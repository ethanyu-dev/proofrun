{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://proofrun.invalid/contracts/0.1/step-result.schema.json",
  "title": "StepResult",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "stepId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$",
      "description": "对应规范化步骤的稳定身份。"
    },
    "status": {
      "enum": [
        "PENDING",
        "RUNNING",
        "COMPLETED",
        "BLOCKED",
        "ERROR",
        "SKIPPED"
      ],
      "description": "执行生命周期，与 criteria 中的业务验收结论分开。"
    },
    "summary": {
      "type": "string",
      "description": "该步骤已观察事实或未完成原因。"
    },
    "evidenceRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      },
      "description": "本步骤执行事实引用的控制面证据身份。"
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterionId", "verdict", "summary", "evidenceRefs"],
        "properties": {
          "criterionId": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "enum": ["PASSED", "FAILED", "INCONCLUSIVE", "SKIPPED"]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidenceRefs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "verdict": {
                  "enum": ["PASSED", "FAILED"]
                }
              },
              "required": ["verdict"]
            },
            "then": {
              "properties": {
                "evidenceRefs": {
                  "type": "array",
                  "minItems": 1
                }
              }
            }
          }
        ]
      },
      "description": "仅包含本步骤已执行的验收项，未执行步骤为空。"
    },
    "startedAt": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "步骤开始时间；未开始为 null。"
    },
    "finishedAt": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "步骤结束时间；未结束或无法确认时为 null。"
    },
    "reasonCode": {
      "type": ["string", "null"],
      "description": "稳定的未完成原因码，预算耗尽按受阻记录。"
    },
    "budgetUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["elapsedMs", "modelCalls", "actions", "limit"],
      "properties": {
        "elapsedMs": {
          "type": "integer",
          "minimum": 0
        },
        "modelCalls": {
          "type": "integer",
          "minimum": 0
        },
        "actions": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["timeoutMs", "maxActions", "maxModelCalls"],
          "properties": {
            "timeoutMs": {
              "type": "integer",
              "minimum": 1
            },
            "maxActions": {
              "type": "integer",
              "minimum": 0
            },
            "maxModelCalls": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      },
      "description": "本步骤实际用量；清理多步各记录增量，额度由整段清理共享。业务耗时排除人工等待。"
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "status": {
            "enum": ["SATISFIED", "UNSATISFIED", "UNCONFIRMED"]
          },
          "source": {
            "enum": ["observation", "human"]
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 32
          },
          "controlRevision": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": ["id", "description", "status", "source", "evidenceRefs"]
      },
      "maxItems": 64
    },
    "blockage": {
      "type": "object",
      "additionalProperties": false,
      "description": "阻塞时冻结的条件与页面证据；后续清理不能替换该快照。",
      "required": ["conditions", "evidenceRefs", "recordedAt"],
      "properties": {
        "conditions": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "description", "summary", "status"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": ["UNCONFIRMED", "UNSATISFIED"]
              }
            }
          }
        },
        "evidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "recordedAt": {
          "type": "string",
          "format": "date-time",
          "description": "执行器冻结阻塞记录的时间，不冒充节点截图拍摄时间。"
        },
        "screenshotError": {
          "type": "string",
          "description": "截图未取得时保留原因，不覆盖原始阻塞原因。"
        }
      }
    },
    "groupId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "phase": {
      "enum": ["PREPARING", "CHECKING", "READY", "VERIFYING", "CLEANUP"],
      "description": "环境准备先操作再检查 policy，READY 才允许本组验证。"
    }
  },
  "required": [
    "stepId",
    "status",
    "summary",
    "evidenceRefs",
    "criteria",
    "startedAt",
    "finishedAt"
  ]
}
