{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://proofrun.invalid/contracts/0.1/step-result.schema.json",
  "title": "StepResult",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "stepId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$",
      "description": "对应规范化步骤的稳定身份。"
    },
    "status": {
      "enum": [
        "PENDING",
        "RUNNING",
        "COMPLETED",
        "BLOCKED",
        "ERROR",
        "SKIPPED"
      ],
      "description": "执行生命周期，与 criteria 中的业务验收结论分开。"
    },
    "summary": {
      "type": "string",
      "description": "该步骤已观察事实或未完成原因。"
    },
    "evidenceRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      },
      "description": "本步骤执行事实引用的控制面证据身份。"
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterionId", "verdict", "summary", "evidenceRefs"],
        "properties": {
          "criterionId": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "enum": ["PASSED", "FAILED", "INCONCLUSIVE", "SKIPPED"]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidenceRefs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "verdict": {
                  "enum": ["PASSED", "FAILED"]
                }
              },
              "required": ["verdict"]
            },
            "then": {
              "properties": {
                "evidenceRefs": {
                  "type": "array",
                  "minItems": 1
                }
              }
            }
          }
        ]
      },
      "description": "仅包含本步骤已执行的验收项，未执行步骤为空。"
    },
    "startedAt": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "步骤开始时间；未开始为 null。"
    },
    "finishedAt": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "步骤结束时间；未结束或无法确认时为 null。"
    }
  },
  "required": [
    "stepId",
    "status",
    "summary",
    "evidenceRefs",
    "criteria",
    "startedAt",
    "finishedAt"
  ]
}
