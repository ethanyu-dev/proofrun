{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://proofrun.invalid/contracts/0.1/verification-case.schema.json",
  "title": "VerificationCase",
  "description": "上层定义的单次验证 case；环境、登录态、取证方式和预算由平台配置。",
  "type": "object",
  "additionalProperties": false,
  "required": ["caseId", "description", "url", "acceptanceCriteria"],
  "properties": {
    "caseId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,100}$",
      "description": "本次验证的幂等身份；再次执行使用新的身份。"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "完整任务描述：验证目标、业务背景、涉及对象及必要约束。"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "description": "本次验证的 HTTP(S) 入口地址，由调用方明确提供，必须能从执行节点访问。"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S",
        "maxLength": 2000
      },
      "description": "可选的必要业务步骤；不要求提供选择器或固定页面点击路径。"
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "expectedResult"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S",
            "description": "任务内唯一的验收项身份，结果通过 criterionId 对应。"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "检查对象、范围及必要观察时机。"
          },
          "expectedResult": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "可以据证据判断的预期业务结果。"
          }
        }
      },
      "description": "上层定义的完整业务验收项；缺少标准时不由平台自行补写。"
    }
  }
}
