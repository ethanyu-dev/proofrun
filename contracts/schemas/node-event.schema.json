{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NodeEvent",
  "description": "Browser Node 发往控制面的心跳、执行结果及可靠交付事件。",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "command.result"
        },
        "protocolVersion": {
          "const": "0.1"
        },
        "messageId": {
          "type": "string"
        },
        "commandId": {
          "type": "string"
        },
        "sessionId": {
          "type": "string"
        },
        "nodeId": {
          "type": "string"
        },
        "nodeEpoch": {
          "type": "string"
        },
        "leaseId": {
          "type": "string"
        },
        "fence": {
          "type": "integer",
          "minimum": 0
        },
        "operationStatus": {
          "description": "浏览器命令的执行状态；不代表验收项结论。",
          "enum": ["SUCCEEDED", "FAILED", "UNKNOWN", "CANCELLED", "TIMED_OUT"]
        },
        "effect": {
          "description": "命令对页面或业务系统产生效果的确定程度；MAY_HAVE_HAPPENED 不可盲目重试。",
          "enum": ["NOT_STARTED", "COMPLETED", "MAY_HAVE_HAPPENED"]
        },
        "data": {
          "type": "object"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "required": ["code", "message"]
        }
      },
      "required": [
        "type",
        "protocolVersion",
        "messageId",
        "commandId",
        "sessionId",
        "nodeId",
        "nodeEpoch",
        "leaseId",
        "fence",
        "operationStatus",
        "effect"
      ],
      "description": "已持久化的命令终态；控制面持久接收后按 messageId ACK。"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "command.pending"
        },
        "protocolVersion": {
          "const": "0.1"
        },
        "messageId": {
          "type": "string"
        },
        "commandId": {
          "type": "string"
        },
        "sessionId": {
          "type": "string"
        },
        "nodeId": {
          "type": "string"
        },
        "nodeEpoch": {
          "type": "string"
        },
        "leaseId": {
          "type": "string"
        },
        "fence": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "protocolVersion",
        "messageId",
        "commandId",
        "sessionId",
        "nodeId",
        "nodeEpoch",
        "leaseId",
        "fence"
      ],
      "description": "相同 commandId 正在执行，节点不会再次派发浏览器动作。"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "node.heartbeat"
        },
        "protocolVersion": {
          "const": "0.1"
        },
        "nodeId": {
          "type": "string"
        },
        "nodeEpoch": {
          "type": "string"
        },
        "leaseRequestId": {
          "description": "租约授权必须回带此 ID；租约时长从本心跳发出时计起。",
          "type": "string"
        },
        "pool": {
          "type": "string"
        },
        "occupied": {
          "description": "本机尚未释放资源的会话，包括关闭中和隔离状态；数量不作为固定准入上限。",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sessionId": {
                "type": "string"
              },
              "state": {
                "type": "string"
              },
              "leaseId": {
                "type": "string"
              },
              "fence": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": ["sessionId", "state", "leaseId", "fence"]
          }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "observe": {
              "type": "boolean"
            },
            "screenshot": {
              "type": "boolean"
            },
            "conditionWait": {
              "type": "boolean"
            },
            "writeActions": {
              "description": "节点是否允许写动作；开发开关打开也不表示引擎写入语义已验证。",
              "type": "boolean"
            },
            "engineWritesVerified": {
              "description": "引擎在业务成功但响应丢失时的重试行为是否完成验证。",
              "type": "boolean"
            },
            "networkEvidence": {
              "type": "boolean"
            },
            "authState": {
              "type": "boolean",
              "description": "支持任务绑定的节点本地登录状态复用。"
            },
            "liveView": {
              "type": "boolean"
            },
            "trace": {
              "type": "boolean",
              "description": "支持 Chromium trace 的采集、可靠上传和下载。"
            },
            "renewableSessions": {
              "type": "boolean",
              "description": "支持人工等待暂停时限的可续期会话。"
            },
            "identityPreparation": {
              "type": "boolean",
              "description": "支持引用节点私有身份库并在独立准备阶段核验登录。"
            },
            "cookieCleanup": {
              "type": "boolean",
              "description": "支持仅删除指定站点指定名字的 Cookie 并回读验证"
            },
            "profileTabs": {
              "type": "boolean",
              "description": "支持分组标签页及每页独立观察引用。"
            },
            "environmentProof": {
              "type": "boolean"
            },
            "fullProfile": {
              "type": "boolean"
            },
            "nodeProfileManagement": {
              "type": "boolean",
              "description": "支持 Console 维护节点默认 profile，并供新身份复制。"
            },
            "externalAccounts": {
              "type": "boolean",
              "description": "支持外部 Cookie 完整属性、临时隔离及不可续期账号硬期限。"
            },
            "ephemeralProfiles": {
              "type": "boolean",
              "description": "案例使用临时目录和输入身份材料，不恢复或保存本地身份基准。"
            },
            "directHitl": {
              "type": "boolean"
            }
          },
          "required": [
            "observe",
            "screenshot",
            "conditionWait",
            "writeActions",
            "engineWritesVerified",
            "networkEvidence"
          ]
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "description": "节点接受的租约和会话硬期限上限，控制面不得超额授权。",
          "required": ["maxLeaseMs", "maxSessionMs"],
          "properties": {
            "maxLeaseMs": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 120000
            },
            "maxSessionMs": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 86400000
            }
          }
        },
        "runtime": {
          "$ref": "node-runtime.schema.json"
        },
        "publicUrl": {
          "type": "string",
          "format": "uri"
        },
        "admission": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "accepting": {
              "type": "boolean"
            },
            "reason": {
              "type": "string"
            },
            "cpuPercent": {
              "type": "number",
              "minimum": 0
            },
            "availableBytes": {
              "type": "integer",
              "minimum": 0
            },
            "reserveBytes": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "accepting",
            "reason",
            "cpuPercent",
            "availableBytes",
            "reserveBytes"
          ]
        }
      },
      "required": [
        "type",
        "protocolVersion",
        "nodeId",
        "nodeEpoch",
        "leaseRequestId",
        "pool",
        "occupied",
        "capabilities",
        "limits"
      ],
      "description": "节点当前身份、租约请求、容量占用和能力声明。"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "protocol.error"
        },
        "code": {
          "type": "string"
        }
      },
      "required": ["type", "code"],
      "description": "协议消息无效或节点暂时无法接收；不表示产品验收失败。"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "artifact.available"
        },
        "messageId": {
          "type": "string"
        },
        "artifactId": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": ["type", "messageId", "artifactId", "sha256"],
      "description": "截图已获得持久化存储回执，可以供报告引用。"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "session.closed"
        },
        "messageId": {
          "type": "string"
        },
        "sessionId": {
          "type": "string"
        },
        "nodeEpoch": {
          "type": "string"
        },
        "leaseId": {
          "type": "string"
        },
        "fence": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "enum": ["CLOSED", "QUARANTINED"]
        },
        "closureVerified": {
          "description": "只有 true 才表示进程资源已确认回收，容量可以释放。",
          "type": "boolean"
        },
        "closeReason": {
          "type": "string",
          "enum": [
            "SESSION_CLOSE_REQUESTED",
            "NODE_SHUTDOWN",
            "NODE_RESTART_RECOVERY",
            "SESSION_LEASE_EXPIRED",
            "SESSION_START_FAILED",
            "HOST_EXITED",
            "HOST_CHANNEL_CLOSED",
            "SESSION_OPERATION_FAILED",
            "SESSION_COMMAND_TIMEOUT",
            "UNKNOWN"
          ],
          "description": "节点保存的首个关闭触发原因；旧节点可省略，不从关闭结果倒推原因。"
        }
      },
      "required": [
        "type",
        "messageId",
        "sessionId",
        "nodeEpoch",
        "leaseId",
        "fence",
        "state",
        "closureVerified"
      ],
      "description": "会话关闭或进入隔离；QUARANTINED 仍占用节点容量。"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "hitl.result"
        },
        "messageId": {
          "type": "string"
        },
        "nodeId": {
          "type": "string"
        },
        "nodeEpoch": {
          "type": "string"
        },
        "sessionId": {
          "type": "string"
        },
        "leaseId": {
          "type": "string"
        },
        "fence": {
          "type": "integer"
        },
        "interventionId": {
          "type": "string"
        },
        "controlRevision": {
          "type": "integer",
          "minimum": 0
        },
        "authRevision": {
          "type": "integer",
          "minimum": 0
        },
        "commandId": {
          "type": "string"
        },
        "operationStatus": {
          "enum": ["SUCCEEDED", "FAILED", "TIMED_OUT", "UNKNOWN", "CANCELLED"]
        },
        "effect": {
          "enum": ["NOT_STARTED", "COMPLETED", "MAY_HAVE_HAPPENED"]
        },
        "error": {
          "type": "object"
        },
        "operation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": ["browser.input", "browser.cookies.set", "browser.act"]
            },
            "action": {
              "type": "string"
            }
          },
          "required": ["type"]
        }
      },
      "required": [
        "type",
        "messageId",
        "nodeId",
        "nodeEpoch",
        "sessionId",
        "leaseId",
        "fence",
        "interventionId",
        "controlRevision",
        "authRevision",
        "commandId",
        "operationStatus",
        "effect",
        "operation"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "hitl.finished"
        },
        "messageId": {
          "type": "string"
        },
        "nodeId": {
          "type": "string"
        },
        "nodeEpoch": {
          "type": "string"
        },
        "sessionId": {
          "type": "string"
        },
        "leaseId": {
          "type": "string"
        },
        "fence": {
          "type": "integer"
        },
        "interventionId": {
          "type": "string"
        },
        "controlRevision": {
          "type": "integer",
          "minimum": 0
        },
        "authRevision": {
          "type": "integer",
          "minimum": 0
        },
        "completion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": ["complete", "unable"]
            },
            "confirmedItems": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9
              },
              "maxItems": 10
            },
            "confirmedConditionKeys": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              },
              "maxItems": 10
            },
            "reason": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "required": ["type"]
        }
      },
      "required": [
        "type",
        "messageId",
        "nodeId",
        "nodeEpoch",
        "sessionId",
        "leaseId",
        "fence",
        "interventionId",
        "controlRevision",
        "authRevision",
        "completion"
      ]
    }
  ]
}
