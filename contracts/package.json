{
  "name": "@proofrun/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./public-api.openapi.json": "./public-api.openapi.json",
    "./dashboard": {
      "types": "./dist/dashboard.d.ts",
      "default": "./dist/dashboard.js"
    },
    "./request-verification": {
      "types": "./dist/request-verification.d.ts",
      "default": "./dist/request-verification.js"
    },
    "./benchmark": {
      "types": "./dist/benchmark.d.ts",
      "default": "./dist/benchmark.js"
    },
    "./release": {
      "types": "./dist/release.d.ts",
      "default": "./dist/release.js"
    },
    "./deployment": {
      "types": "./dist/deployment.d.ts",
      "default": "./dist/deployment.js"
    },
    "./benchmark-scenarios": {
      "types": "./dist/benchmark-scenarios.d.ts",
      "default": "./dist/benchmark-scenarios.js"
    },
    "./verification-capabilities": {
      "types": "./dist/verification-capabilities.d.ts",
      "default": "./dist/verification-capabilities.js"
    },
    "./benchmark-v2": {
      "types": "./dist/benchmark-v2.d.ts",
      "default": "./dist/benchmark-v2.js"
    },
    "./benchmark-interactions": {
      "types": "./dist/benchmark-interactions.d.ts",
      "default": "./dist/benchmark-interactions.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "public-api.openapi.json",
    "fixtures"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
