# 应用不会自动加载 .env；启动前导出配置。先为本机 PostgreSQL 设置密码。
PROOFRUN_POSTGRES_PASSWORD=
PROOFRUN_DATABASE_URL=postgresql://proofrun:replace-with-local-password@127.0.0.1:5432/proofrun
# 分别生成两个不同的随机密钥，长度至少 32；不把管理员密钥交给 worker 或节点。
PROOFRUN_ADMIN_TOKEN=
PROOFRUN_WORKER_TOKEN=
PROOFRUN_API_HOST=127.0.0.1
PROOFRUN_API_PORT=4100
# 多副本时设为 true；共享数据库、证据目录和密钥，负载均衡只路由 /health/ready=200 的副本。
PROOFRUN_API_HA=false
PROOFRUN_PUBLIC_URL=http://127.0.0.1:4100
# 本地 Console 分端口时用于生成 HITL 链接；生产同源部署时留空。
PROOFRUN_CONSOLE_URL=http://127.0.0.1:5173
# 可选飞书企业自建应用机器人；三个变量同时填写或全部留空，仅配置到 API。
# 提交、HITL、恢复和结束发送新卡片，并更新本应用之前发送的卡片。
PROOFRUN_FEISHU_APP_ID=
PROOFRUN_FEISHU_APP_SECRET=
PROOFRUN_FEISHU_CHAT_ID=
PROOFRUN_ARTIFACT_DIRECTORY=.proofrun/api-artifacts
# case 入口的服务端执行配置；复制 deploy/case-profile.example.json 并替换实际环境。
# 不设置时不接收新 case；配置不会通过公开 case 响应返回。
PROOFRUN_CASE_PROFILE_FILE=
PROOFRUN_WORKER_LEASE_MS=15000
PROOFRUN_NODE_LEASE_MS=20000
# Rust Node 的其他参数使用 --config node.toml；这些环境变量可覆盖路径。
PROOFRUN_NODE_HOME=.proofrun
PROOFRUN_AGENT_BROWSER_BIN=agent-browser
# PROOFRUN_CHROME_BIN=/usr/bin/google-chrome
# 执行 Agent：Chat Completions 服务根地址，例如服务的 /v1，不包含 /chat/completions。
# 供应商与模型名没有默认值，密钥只从启动环境读取。
PROOFRUN_CONTROL_URL=http://127.0.0.1:4100
PROOFRUN_MODEL_BASE_URL=
PROOFRUN_MODEL_API_KEY=
PROOFRUN_MODEL=
PROOFRUN_MODEL_VISION=false
PROOFRUN_MODEL_TOKEN_PARAMETER=max_completion_tokens
# default 不传 thinking；显式思考模式使用 auto 工具选择，回复仍校验单个工具。
PROOFRUN_MODEL_THINKING=default
# default 不传 reasoning_effort；low/high/max 设置思考强度，thinking=disabled 优先关闭思考。
PROOFRUN_MODEL_REASONING_EFFORT=default
# 单次输出包含推理 token；显式配置范围 256–65536。
PROOFRUN_MODEL_MAX_TOKENS=4096
# 每次真实模型请求均计入；新版 v2 使用冻结的逐步额度。
PROOFRUN_AGENT_MAX_TURNS=200
PROOFRUN_AGENT_CONTEXT_CHARS=64000
# 单次模型请求时限范围 100–600000 毫秒，身份选择仍受独立租约限制。
PROOFRUN_AGENT_MODEL_MS=30000
PROOFRUN_AGENT_COMMAND_MS=15000
# 命令成功后独立等待证据上传和可用回执；仍受任务总期限与租约约束。
PROOFRUN_AGENT_EVIDENCE_MS=60000
PROOFRUN_AGENT_HTTP_MS=5000
PROOFRUN_AGENT_POLL_MS=1000
# 同时领取的任务数受 Agent 槽数与节点容量共同约束。
PROOFRUN_AGENT_CONCURRENCY=2
# 可选；不设时每次进程启动生成随机身份。
# PROOFRUN_WORKER_ID=worker-local

# Console 开发服务器代理；只在服务端读取，不能在 VITE_* 中配置管理员密钥。
PROOFRUN_API_PROXY=http://127.0.0.1:4100

# 可选 HTTPS Console：填写浏览器信任的本地证书与私钥路径，画面自动使用 WSS。
# PROOFRUN_TLS_CERT=/absolute/path/localhost.crt
# PROOFRUN_TLS_KEY=/absolute/path/localhost.key

# 每次人工请求最多等待三十分钟；独立于业务预算与人工链接有效期，允许 1000–86400000 毫秒。
PROOFRUN_HUMAN_WAIT_MS=1800000

# 可选 DevPass 接入；配置文件、访问令牌和接收私钥均要求 0600。
# PROOFRUN_DEVPASS_CONFIG_FILE=/absolute/private/devpass.json
